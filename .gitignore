# 模型结构、权重、原始/校准样本数据（未公开）
hspc_encoder/

# 导出产物（依赖模型结构，且体积大）
onnx/
engines/*.plan
engines/*.calib
scratch/
*.pt
*.onnx
*.plan

# 含原始HSI波段值/原始光谱/点云坐标的缓存
results/e2e_scene_preprocessed.npz
results/e2e_scene_geo.json

# 真实场景的逐样本索引与匹配输出（仅保留本地）
results/e2e_scene_index.npz
results/stage4_fp32_match.npz

# 真实样本经真实权重算出的参考特征（暂不公开）
results/ref/

# 本机profiling产物（含主机名/路径等本地信息）
results/logs/*.nsys-rep

# 跨模态匹配打分规则（课题方法本身，未公开）
scripts/matching.py

# 杂项
__pycache__/
*.pyc
*:Zone.Identifier

# Jetson 板上结果：真实样本的参考特征与场景匹配输出（与上面 results/ref/、stage4_fp32_match.npz 同规则）
results/jetson/ref/
results/jetson/*.npz
results/jetson/logs/nsys/*.nsys-rep
results/jetson/logs/nsys/*.sqlite
# 多场景验证的缓存输入（含原始 HSI 波段值与点云坐标，同上）
results/scenes/*.npz
# Jetson 完整端到端每次运行的原始 JSON（含每个点的匹配行列，同上面"匹配输出仅保留本地"）；公开的是汇总 e2e_full_summary.json / e2e_las_summary.json
results/jetson/e2e_full/
# 同上：控制台日志里打印了整份结果 JSON（含每个点的匹配行列）
results/jetson/logs/p5_A_*.log

# TensorRT 完整逐层导出包含比公开范围更完整的层名和张量维度（全网络逐层，非选择性混合精度用到的层组名）
results/jetson/logs/int8diag/*_layers.json

# C++ 部署：不入库的私有匹配规则头文件与构建目录
cpp/src/matching_rule.cuh
cpp/build/
# C++ 部署每次运行的原始 JSON（含每个点的匹配行列，同 e2e_full/）；公开的是汇总 cpp_e2e_summary.json
results/jetson/cpp_e2e/
results/jetson/cpp_power/energy_*.json
results/jetson/cpp_power/cold_*.log
results/jetson/cpp_power/energy_*.log
